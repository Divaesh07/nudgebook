# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Speech to text (Deepgram first, Groq Whisper fallback)
DEEPGRAM_API_KEY=
# LLM parsing + Whisper fallback: https://console.groq.com/keys (free)
GROQ_API_KEY=

# Web Push: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for pg_cron → /api/cron/dispatch (any long random string)
CRON_SECRET=

# Optional: Google sign-in + Calendar sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
